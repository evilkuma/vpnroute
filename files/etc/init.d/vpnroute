#!/bin/sh /etc/rc.common
# vpnroute: точечная маршрутизация через Xray (TPROXY + FakeDNS)

START=99
STOP=10
USE_PROCD=1

XRAY_BIN=/usr/bin/xray
GEN=/usr/share/vpnroute/gen.uc
RUN_DIR=/var/etc/vpnroute
XRAY_CONF=$RUN_DIR/xray.json
NFT_FILE=$RUN_DIR/vpnroute.nft

log() {
	logger -t vpnroute "$*"
}

read_net_opts() {
	config_load vpnroute
	config_get MARK main fwmark 0x40000
	config_get TABLE main route_table 107
}

net_up() {
	read_net_opts
	ip rule del fwmark "$MARK" lookup "$TABLE" 2>/dev/null
	ip rule add fwmark "$MARK" lookup "$TABLE" pref 1107 || return 1
	ip route replace local 0.0.0.0/0 dev lo table "$TABLE" || return 1
	nft -f "$NFT_FILE"
}

net_down() {
	read_net_opts
	nft delete table inet vpnroute 2>/dev/null
	while ip rule del fwmark "$MARK" lookup "$TABLE" 2>/dev/null; do :; done
	ip route flush table "$TABLE" 2>/dev/null
}

dnsmasq_hup() {
	killall -HUP dnsmasq 2>/dev/null
}

clear_dns() {
	case "$(ucode "$GEN" --clear)" in
		*dnsmasq*) dnsmasq_hup ;;
	esac
}

fail() {
	log "$*"
	net_down
	clear_dns
	return 1
}

start_service() {
	local enabled changes out

	config_load vpnroute
	config_get_bool enabled main enabled 0
	if [ "$enabled" != 1 ]; then
		net_down
		clear_dns
		return 0
	fi

	[ -x "$XRAY_BIN" ] || { fail "не найден $XRAY_BIN"; return 1; }

	mkdir -p "$RUN_DIR"
	changes="$(ucode "$GEN" 2>"$RUN_DIR/gen.log")" || {
		fail "ошибка генерации конфигурации: $(cat "$RUN_DIR/gen.log")"
		return 1
	}
	[ -s "$RUN_DIR/gen.log" ] && logger -t vpnroute < "$RUN_DIR/gen.log"

	out="$("$XRAY_BIN" run -test -c "$XRAY_CONF" 2>&1)" || {
		fail "конфигурация Xray не прошла проверку: $out"
		return 1
	}

	net_up || { fail "ошибка применения правил маршрутизации"; return 1; }

	case "$changes" in
		*dnsmasq*) dnsmasq_hup ;;
	esac

	procd_open_instance xray
	procd_set_param command "$XRAY_BIN" run -c "$XRAY_CONF"
	procd_set_param env XRAY_LOCATION_ASSET=/usr/share/xray
	# при изменении файла procd перезапустит Xray на reload, иначе оставит работать
	procd_set_param file "$XRAY_CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	procd_close_instance
}

stop_service() {
	net_down
	clear_dns
}

reload_service() {
	start
}

service_triggers() {
	procd_add_reload_trigger "vpnroute"
}
