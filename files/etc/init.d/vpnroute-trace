#!/bin/sh /etc/rc.common
# vpnroute: сеанс диагностики трафика одного устройства.
# Не включается в автозагрузку. Управление: vpnroute trace start|stop

USE_PROCD=1
SESSION=/tmp/vpnroute-trace/session

start_service() {
	local ip seconds
	[ -f "$SESSION" ] || return 1
	read -r ip seconds < "$SESSION"
	[ -n "$ip" ] && [ -n "$seconds" ] || return 1

	procd_open_instance collector
	procd_set_param command /usr/bin/ucode /usr/share/vpnroute/trace.uc run "$ip" "$seconds"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
