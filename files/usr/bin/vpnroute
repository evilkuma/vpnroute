#!/bin/sh
# vpnroute: управление точечной маршрутизацией через Xray

INIT=/etc/init.d/vpnroute
GEN=/usr/share/vpnroute/gen.uc
STATUS=/usr/share/vpnroute/status.uc
DNSMASQ_FILE=/etc/vpnroute/dnsmasq.servers
FAKE_RE='^198\.1[89]\.'

usage() {
	cat <<'EOF'
Использование: vpnroute <команда> [аргументы]

  status                    краткое состояние
  enable | disable          включить или выключить маршрутизацию
  apply                     применить настройки (то же, что «Сохранить и применить» в LuCI)
  restart                   полный перезапуск
  device list               список устройств
  device <имя|MAC> on|off|toggle
                            весь трафик устройства через VPN: вкл/выкл/переключить
  check <домен|IP>          куда пойдёт трафик: через туннель или напрямую
  logs [N]                  последние N строк журнала (по умолчанию 50)
  gen                       показать сгенерированную конфигурацию Xray

Диагностика трафика устройства:
  trace start <IP> [минут]  начать запись (по умолчанию 15 минут, максимум 120)
  trace stop                остановить запись
  trace status              идёт ли запись
  trace devices             устройства локальной сети (JSON)
  trace dump                данные последнего сеанса (JSON)

  list-add <список> <домен|IP> [название]
                            добавить запись в список; вместо имени списка
                            «new» создаёт новый список с указанным названием
EOF
}

TRACE_DIR=/tmp/vpnroute-trace
TRACE_LOG=/var/run/dnsmasq/vpnroute-trace.log
NL='
'

dnsmasq_confdir() {
	local cfg dir
	cfg="$(uci -X show dhcp | sed -n 's/^dhcp\.\([^.=]*\)=dnsmasq$/\1/p' | head -n1)"
	dir="$(uci -q get dhcp."$cfg".confdir)"
	[ -n "$dir" ] || dir="/tmp/dnsmasq${cfg:+.$cfg}.d"
	echo "${dir%%,*}"
}

trace_running() {
	ubus call service list '{"name":"vpnroute-trace"}' 2>/dev/null | grep -q '"running": true'
}

# Журнал DNS-запросов dnsmasq включается только на время записи
trace_dns_on() {
	local dir
	dir="$(dnsmasq_confdir)"
	mkdir -p "$dir"
	rm -f "$TRACE_LOG"
	printf 'log-queries=extra\nlog-facility=%s\n' "$TRACE_LOG" > "$dir/vpnroute-trace.conf"
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
}

trace_dns_off() {
	local dir
	dir="$(dnsmasq_confdir)"
	if [ -f "$dir/vpnroute-trace.conf" ]; then
		rm -f "$dir/vpnroute-trace.conf"
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi
	rm -f "$TRACE_LOG"
}

cmd_trace() {
	local ip min
	case "$1" in
		devices)
			ucode /usr/share/vpnroute/trace.uc devices
			;;
		start)
			ip="$2"
			min="${3:-15}"
			echo "$ip" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || { echo "Укажите IP-адрес устройства" >&2; return 1; }
			echo "$min" | grep -qE '^[0-9]+$' && [ "$min" -ge 1 ] && [ "$min" -le 120 ] || { echo "Длительность: от 1 до 120 минут" >&2; return 1; }
			/etc/init.d/vpnroute-trace stop 2>/dev/null
			mkdir -p "$TRACE_DIR"
			rm -f "$TRACE_DIR/state.json"
			echo "$ip $((min * 60))" > "$TRACE_DIR/session"
			trace_dns_on
			/etc/init.d/vpnroute-trace start
			echo "Запись трафика $ip начата на $min мин."
			;;
		stop)
			[ "$2" = "--from-collector" ] || /etc/init.d/vpnroute-trace stop 2>/dev/null
			rm -f "$TRACE_DIR/session"
			trace_dns_off
			echo "Запись остановлена"
			;;
		status)
			if trace_running; then
				echo "Идёт запись: $(cut -d' ' -f1 "$TRACE_DIR/session" 2>/dev/null)"
			else
				echo "Запись не идёт"
			fi
			;;
		dump)
			local err=""
			if trace_running; then
				printf '{"running":true,"state":'
			else
				printf '{"running":false,"state":'
				# Сборщик завершился, не дойдя до конца сеанса (например, из-за ошибки):
				# журнал DNS мог остаться включённым — выключить
				trace_dns_off
				if [ -f "$TRACE_DIR/session" ] && ! grep -q '"ended": true' "$TRACE_DIR/state.json" 2>/dev/null; then
					err="$(logread | grep 'daemon.err ucode' | grep -E 'error' | tail -n 1 | sed 's/.*ucode\[[0-9]*\]: //; s/\\/\\\\/g; s/"/\\"/g')"
					[ -n "$err" ] || err="сбор данных завершился раньше времени"
				fi
			fi
			if [ -s "$TRACE_DIR/state.json" ]; then cat "$TRACE_DIR/state.json"; else printf 'null'; fi
			[ -n "$err" ] && printf ',"error":"%s"' "$err"
			printf '}\n'
			;;
		*)
			usage >&2
			return 1
			;;
	esac
}

cmd_list_add() {
	local target="$1" value kind s name
	value="$(echo "$2" | tr 'A-Z' 'a-z' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
	[ -n "$target" ] && [ -n "$value" ] || { echo "Использование: vpnroute list-add <список|new> <домен|IP> [название]" >&2; return 1; }

	if echo "$value" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$'; then
		kind=ip
	else
		value="$(echo "$value" | sed 's#^[a-z]*://##; s#[/:?].*$##; s#^\*\.##; s#^\.##; s#\.$##')"
		echo "$value" | grep -qE '^[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?(\.[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?)+$' || {
			echo "Некорректный домен или адрес: $2" >&2
			return 1
		}
		kind=domain
	fi

	if [ "$target" = "new" ]; then
		name="${3:-Новый список}"
		s="$(uci add vpnroute list)"
		uci set vpnroute."$s".name="$name"
		uci set vpnroute."$s".enabled=1
	else
		s="$target"
		[ "$(uci -q get vpnroute."$s")" = "list" ] || { echo "Список «$target» не найден" >&2; return 1; }
		name="$(uci -q get vpnroute."$s".name)"
		if uci -q -d "$NL" get vpnroute."$s"."$kind" | sed 's/#.*//; s/[[:space:]]*$//' | grep -qxF "$value"; then
			echo "«$value» уже есть в списке «$name»"
			return 0
		fi
	fi

	uci add_list vpnroute."$s"."$kind"="$value"
	uci commit vpnroute
	"$INIT" reload
	echo "«$value» добавлен в список «$name»"
	[ "$(uci -q get vpnroute."$s".enabled)" = "0" ] && echo "Внимание: список «$name» выключен"
	[ "$(uci -q get vpnroute.main.enabled)" = "1" ] || echo "Внимание: маршрутизация выключена"
	return 0
}

uci_sections() {
	uci -q show vpnroute | sed -n "s/^vpnroute\.\([^.=]*\)=$1\$/\1/p"
}

find_device() {
	local key s mac
	key="$(echo "$1" | tr 'A-Z' 'a-z')"
	for s in $(uci_sections device); do
		mac="$(uci -q get vpnroute."$s".mac | tr 'A-Z' 'a-z')"
		if [ "$s" = "$1" ] || [ "$mac" = "$key" ] || [ "$(uci -q get vpnroute."$s".name)" = "$1" ]; then
			echo "$s"
			return 0
		fi
	done
	return 1
}

cmd_status() {
	local enabled running rules
	enabled="$(uci -q get vpnroute.main.enabled)"
	pidof xray >/dev/null && running="работает" || running="остановлен"
	nft list table inet vpnroute >/dev/null 2>&1 && rules="применены" || rules="не применены"
	echo "Маршрутизация: $([ "$enabled" = 1 ] && echo включена || echo выключена)"
	echo "Xray:          $running"
	echo "Правила:       $rules"
	local n
	n="$(grep -c '127.0.0.1#' "$DNSMASQ_FILE" 2>/dev/null)"
	echo "Доменов в DNS: ${n:-0}"
	echo "Устройств «всё в VPN»: $(nft list set inet vpnroute tunnel_macs 2>/dev/null | grep -o '..:..:..:..:..:..' | wc -l)"
}

cmd_device() {
	local s
	case "$1" in
		""|list)
			for s in $(uci_sections device); do
				printf '%-14s %-18s %s\n' \
					"$(uci -q get vpnroute."$s".name)" \
					"$(uci -q get vpnroute."$s".mac)" \
					"$([ "$(uci -q get vpnroute."$s".enabled)" = 1 ] && echo 'VPN' || echo 'напрямую')"
			done
			return 0
			;;
	esac

	s="$(find_device "$1")" || { echo "Устройство «$1» не найдено" >&2; return 1; }
	case "$2" in
		on) uci set vpnroute."$s".enabled=1 ;;
		off) uci set vpnroute."$s".enabled=0 ;;
		toggle|"")
			if [ "$(uci -q get vpnroute."$s".enabled)" = 1 ]; then
				uci set vpnroute."$s".enabled=0
			else
				uci set vpnroute."$s".enabled=1
			fi
			;;
		*) echo "Ожидается on, off или toggle" >&2; return 1 ;;
	esac
	uci commit vpnroute
	"$INIT" reload
	echo "$(uci -q get vpnroute."$s".name): $([ "$(uci -q get vpnroute."$s".enabled)" = 1 ] && echo 'весь трафик через VPN' || echo 'обычная маршрутизация')"
}

# Ищет домен или его родительский домен в файле для dnsmasq
domain_listed() {
	local d="$1"
	while [ -n "$d" ]; do
		grep -qxF "server=/$d/127.0.0.1#$(uci -q get vpnroute.main.dns_port || echo 1053)" "$DNSMASQ_FILE" 2>/dev/null && { echo "$d"; return 0; }
		case "$d" in
			*.*) d="${d#*.}" ;;
			*) d="" ;;
		esac
	done
	return 1
}

cmd_check() {
	local t="$1" hit addr
	[ -n "$t" ] || { echo "Укажите домен или IP" >&2; return 1; }

	if echo "$t" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'; then
		if nft get element inet vpnroute dst4 "{ $t }" >/dev/null 2>&1; then
			echo "$t: через туннель (входит в список IP)"
		elif echo "$t" | grep -qE "$FAKE_RE"; then
			echo "$t: служебный адрес FakeDNS, через туннель"
		else
			echo "$t: напрямую"
		fi
		return 0
	fi

	t="$(echo "$t" | tr 'A-Z' 'a-z')"
	if hit="$(domain_listed "$t")"; then
		# первая строка Address после Name: — это ответ, а не адрес DNS-сервера
		addr="$(nslookup "$t" 127.0.0.1 2>/dev/null | awk '/^Name:/ { n = 1 } n && /^Address/ { print $NF; exit }')"
		if echo "$addr" | grep -qE "$FAKE_RE"; then
			echo "$t: через туннель (правило $hit, DNS вернул $addr)"
		else
			echo "$t: в списке (правило $hit), но DNS вернул «${addr:-нет ответа}» — проверьте, работает ли Xray"
		fi
	else
		echo "$t: напрямую (нет в списках)"
	fi
}

cmd_net_ensure() {
	local mark table
	mark="$(uci -q get vpnroute.main.fwmark || echo 0x40000)"
	table="$(uci -q get vpnroute.main.route_table || echo 107)"
	ip rule show | grep -q "fwmark $mark lookup $table" || ip rule add fwmark "$mark" lookup "$table" pref 1107
	ip route show table "$table" 2>/dev/null | grep -q '^local' || ip route replace local 0.0.0.0/0 dev lo table "$table"
}

case "$1" in
	status) cmd_status ;;
	status-json) ucode "$STATUS" ;;
	enable)
		uci set vpnroute.main.enabled=1
		uci commit vpnroute
		"$INIT" enable
		"$INIT" restart 2>/dev/null
		sleep 2
		cmd_status
		;;
	disable)
		uci set vpnroute.main.enabled=0
		uci commit vpnroute
		"$INIT" reload
		sleep 1
		cmd_status
		;;
	apply|reload) "$INIT" reload ;;
	start|stop|restart) "$INIT" "$1" ;;
	device) shift; cmd_device "$@" ;;
	trace) shift; cmd_trace "$@" ;;
	list-add) shift; cmd_list_add "$@" ;;
	check) cmd_check "$2" ;;
	gen) ucode "$GEN" --print ;;
	logs) logread | grep -E 'vpnroute|xray' | tail -n "${2:-50}" ;;
	net-ensure) cmd_net_ensure ;;
	""|help|-h|--help) usage ;;
	*) usage >&2; exit 1 ;;
esac
